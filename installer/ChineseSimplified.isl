; Simplified Chinese wizard text for the DeskTrace installer. Layered over Default.isl,
; so any message not translated here still appears (in English).

[LangOptions]
LanguageName=简体中文
LanguageID=$0804
LanguageCodePage=0

[Messages]
SetupAppTitle=安装
SetupWindowTitle=安装 - %1
UninstallAppTitle=卸载
